{{/* app: the page frame, the ui head partial and the ui shell layout with the fleet nav. Data: appShell. */}}
{{define "app"}}<!doctype html>
<html lang="en">
{{template "head" (head .Page.Title)}}
<body>
<a class="ui-button fw-skip" href="#main">Skip to content</a>
<div class="ui-shell">
<nav class="ui-nav" aria-label="Main">
<p class="ui-nav-brand">Factory</p>
<ul>
<li><a href="/"{{if eq .Page.Nav "board"}} aria-current="page"{{end}}>Board</a></li>
<li><a href="/attention"{{if eq .Page.Nav "attention"}} aria-current="page"{{end}}>Attention{{with .Page.Inbox}} <span class="ui-nav-count" aria-label="{{.}} open">{{.}}</span>{{end}}</a></li>
</ul>
{{if not .Page.Local}}{{if ne .Page.Nav "signin"}}<div class="ui-nav-foot fw-signout">
<form method="post" action="/signout"><input type="hidden" name="csrf" value="{{.Page.CSRF}}">{{template "button" (button "Sign out" "submit" "")}}</form>
</div>{{end}}{{end}}
</nav>
<main class="ui-main" id="main" tabindex="-1">{{.Body}}</main>
</div>
<script src="/static/app.js" defer></script>
</body>
</html>{{end}}
